run = "python3 web_app.py"
modules = ["python-3.11"]
[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 web_app.py"]

[workflows]
runButton = "Run Python App"

[[workflows.workflow]]
name = "Run Python App"
author = 44338020
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 web_app.py"

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[agent]
expertMode = true
